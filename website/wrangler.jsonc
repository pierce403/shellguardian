{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shellguardian-website",
  "account_id": "b6d1478423f0bb0c0477df387305e46b",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./dist" },
