{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellGuardian",
  "version": "0.3.1",
  "identifier": "bot.recurse.shellguardian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "ShellGuardian",
        "width": 1440,
        "height": 940,
        "minWidth": 880,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "createUpdaterArtifacts": true,
    "shortDescription": "An intuitive guardian for OpenShell agents",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MEM1QzY4NjNGODc1NDYKUldSR2RmaGphRndNbFc0TmQ2SUsyakFNZHF1MDIyUHd3N0JSbTkwUnhXUDdZUXZNVkthZ3BRRjMK",
      "endpoints": [
        "https://github.com/pierce403/shellguardian/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
